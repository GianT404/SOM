[Unit]
Description=SOM backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=som                        # dedicated service user
EnvironmentFile=/etc/som/som.env
ExecStart=/usr/local/bin/SOM
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=som              # writable /var/lib/som

[Install]
WantedBy=multi-user.target